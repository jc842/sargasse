---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('blog', ({ data }) => !data.draft && data.lang === 'es');
posts.sort((a, b) => new Date(b.data.pubDate).valueOf() - new Date(a.data.pubDate).valueOf());
---

<Layout title="Guía del Sargazo en el Caribe: Playas, Salud y Prevención | Sargasse.com" lang="es">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <header class="mb-12 pb-6 border-b border-emerald-950">
      <div class="flex items-center space-x-2 text-xs font-mono text-lime-400 uppercase tracking-widest mb-2">
        <span>Informes Científicos en Español</span>
        <span>•</span>
        <span>Observatorio del Caribe</span>
      </div>
      <h1 class="text-3xl sm:text-5xl font-heading font-black text-white tracking-tight">
        El Sargazo en el Caribe: Guías y Estudios
      </h1>
      <p class="text-stone-400 text-sm sm:text-base mt-2 max-w-2xl">
        Información contrastada y actualizada sobre el cinturón atlántico de sargazo, toxicología del gas H2S, sistemas de alerta temprana vía satélite, barreras de desvío y playas protegidas en Guadalupe y Martinica.
      </p>
    </header>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {posts.map(post => (
        <article class="p-6 rounded-2xl bg-[#091710] border border-emerald-950 hover:border-lime-500/40 transition-all flex flex-col justify-between group shadow-sm">
          <div>
            <div class="flex items-center justify-between mb-3 text-[11px]">
              <span class="font-mono text-lime-400 font-bold uppercase tracking-wider">
                {post.data.category || 'Informe Ambiental'}
              </span>
              <span class="text-stone-500 font-mono">
                {new Date(post.data.pubDate).toLocaleDateString('es-ES', { day: 'numeric', month: 'short', year: 'numeric' })}
              </span>
            </div>

            <h2 class="text-base font-heading font-bold text-white group-hover:text-lime-300 transition-colors line-clamp-2 mb-3">
              <a href={`/es/${post.id}/`}>{post.data.title}</a>
            </h2>

            <p class="text-xs text-stone-400 line-clamp-3 leading-relaxed mb-4">
              {post.data.description}
            </p>
          </div>

          <div class="pt-4 border-t border-emerald-950/80 flex items-center justify-between text-xs">
            <span class="text-stone-500 font-mono">Por {post.data.author || 'Observatorio Sargazo'}</span>
            <a href={`/es/${post.id}/`} class="font-semibold text-lime-400 group-hover:translate-x-1 transition-transform inline-flex items-center space-x-1">
              <span>Leer informe</span>
              <span>&rarr;</span>
            </a>
          </div>
        </article>
      ))}
    </div>
  </div>
</Layout>
