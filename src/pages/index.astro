---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { siteConfig } from '../config/site.config';
import ReviveSlot from '../components/ads/ReviveSlot.astro';

const allPosts = await getCollection('blog', ({ data }) => !data.draft && (!data.lang || data.lang === 'fr'));
allPosts.sort((a, b) => new Date(b.data.pubDate).valueOf() - new Date(a.data.pubDate).valueOf());
const featuredPosts = allPosts.slice(0, 9);

const observatoryModules = [
  { title: "Surveillance Satellite", code: "SAT-MODIS/SENTINEL", desc: "Suivi optique de la grande ceinture de sargasses de l'Atlantique et modélisation de dérive à 7 jours.", icon: "🛰️", badge: "Live Data" },
  { title: "Santé Publique & H2S", code: "H2S-MONITOR-PPM", desc: "Mesure du sulfure d'hydrogène et de l'ammoniac en bordure de littoral. Seuils de toxicité et recommandations.", icon: "⚠️", badge: "Alerte Sanitaire" },
  { title: "Plages Non Impactées", code: "COTE-CARAIBE-SAFE", desc: "Cartographie des anses et plages sous le vent abritées naturellement des échouements par le relief insulaire.", icon: "🏖️", badge: "Guide Baignade" },
  { title: "Barrages & Récupération", code: "TECH-CLEAN-BARRIERS", desc: "Innovations maritimes : barrages déviateurs en mer, bateaux moissonneurs et collecte respectueuse des sables.", icon: "⚙️", badge: "Solutions" },
  { title: "Bioplastiques & Compost", code: "CIRCULAR-BLUE-ECONOMY", desc: "Projets de valorisation industrielle : biomatériaux, fertilisants après extraction des métaux lourds.", icon: "🌱", badge: "Innovation" },
];
---

<Layout title="Sargasse.com — Observatoire & Prévisions d'Échouements de Sargasses">
  <!-- Hero Section Eco-Scientific Observatory -->
  <section class="relative overflow-hidden pt-12 pb-16 lg:py-24 border-b border-emerald-950/80 bg-gradient-to-b from-[#0e2118] via-[#0a1510] to-[#070e0a]">
    <!-- Ambient Radial Glow -->
    <div class="absolute top-0 left-1/2 -translate-x-1/2 w-full max-w-5xl h-96 bg-gradient-to-b from-lime-500/10 via-emerald-500/5 to-transparent blur-3xl pointer-events-none"></div>

    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <div class="inline-flex items-center space-x-2 px-3 py-1 rounded-full bg-emerald-950/80 border border-lime-500/40 text-lime-300 text-xs font-mono font-semibold tracking-wider uppercase mb-6 shadow-sm">
          <span class="w-2 h-2 rounded-full bg-lime-400 animate-ping"></span>
          <span>Bassin Caraïbes • Observatoire Environnemental</span>
        </div>

        <h1 class="text-4xl sm:text-6xl lg:text-7xl font-heading font-black text-white tracking-tight leading-[1.05] mb-6">
          COMPRENDRE & AGIR FACE AUX <span class="text-transparent bg-clip-text bg-gradient-to-r from-lime-400 via-emerald-300 to-teal-300">SARGASSES</span>.
        </h1>

        <p class="text-lg sm:text-xl text-stone-300 leading-relaxed font-normal mb-8">
          Plateforme de référence pour la surveillance des bancs de sargasses pélagiques aux Antilles : alertes sanitaires (H2S), prévisions de dérive par imagerie satellite, protection du littoral et valorisation en économie circulaire.
        </p>

        <div class="flex flex-wrap items-center gap-4">
          <a href="/blog/" class="px-6 py-3.5 rounded-xl bg-gradient-to-r from-lime-400 to-emerald-400 text-emerald-950 font-heading font-bold text-sm tracking-wide shadow-lg shadow-lime-500/20 hover:scale-[1.02] transition-all">
            Consulter les Rapports d'Analyse &rarr;
          </a>
          <a href="#modules" class="px-6 py-3.5 rounded-xl bg-[#12271d] border border-emerald-800/60 text-lime-200 font-semibold text-sm hover:bg-[#183527] hover:text-white transition-colors">
            Voir les Pôles d'Observation
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- International Guides Hub (i18n) -->
  <section class="border-b border-emerald-950 bg-[#070e0a] py-8">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <a href="/en/" class="group p-5 rounded-2xl bg-gradient-to-br from-[#0e2118] to-[#09150f] border border-emerald-900/40 hover:border-lime-400/60 transition-all flex items-center justify-between">
          <div>
            <div class="flex items-center space-x-2 mb-1">
              <span class="text-xs font-mono font-bold uppercase tracking-wider text-lime-400">English Edition</span>
              <span class="text-[10px] bg-emerald-950 text-lime-300 px-2 py-0.5 rounded border border-emerald-800">EN</span>
            </div>
            <h3 class="text-base font-heading font-bold text-white group-hover:text-lime-300 transition-colors">
              Sargassum Seaweed Guide: Seasons, Beach Safety & Science
            </h3>
            <p class="text-xs text-stone-400 mt-1">
              Comprehensive traveler manual, satellite monitoring insights, and clean beach directories.
            </p>
          </div>
          <span class="text-xl text-lime-400 group-hover:translate-x-1 transition-transform ml-4">&rarr;</span>
        </a>

        <a href="/es/" class="group p-5 rounded-2xl bg-gradient-to-br from-[#0e2118] to-[#09150f] border border-emerald-900/40 hover:border-lime-400/60 transition-all flex items-center justify-between">
          <div>
            <div class="flex items-center space-x-2 mb-1">
              <span class="text-xs font-mono font-bold uppercase tracking-wider text-lime-400">Edición en Español</span>
              <span class="text-[10px] bg-emerald-950 text-lime-300 px-2 py-0.5 rounded border border-emerald-800">ES</span>
            </div>
            <h3 class="text-base font-heading font-bold text-white group-hover:text-lime-300 transition-colors">
              Guía del Sargazo en el Caribe: Playas Limpias, Salud y Tecnología
            </h3>
            <p class="text-xs text-stone-400 mt-1">
              Información verificada sobre prevención de arribos, barreras y costas protegidas.
            </p>
          </div>
          <span class="text-xl text-lime-400 group-hover:translate-x-1 transition-transform ml-4">&rarr;</span>
        </a>
      </div>
    </div>
  </section>

  <!-- Observatory Modules Grid -->
  <section id="modules" class="py-16 border-b border-emerald-950/80 bg-[#0a1510]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col md:flex-row md:items-end justify-between mb-10">
        <div>
          <span class="text-xs font-mono uppercase tracking-widest text-lime-400 font-bold block mb-2">Pôles d'Investigation</span>
          <h2 class="text-2xl sm:text-4xl font-heading font-black text-white tracking-tight">
            5 Axes Majeurs de Surveillance & Recherche
          </h2>
        </div>
        <p class="text-xs sm:text-sm text-stone-400 max-w-md mt-2 md:mt-0">
          De l'orbite géostationnaire au microscope biochimique, panorama des disciplines mobilisées face au défi des sargasses.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 lg:grid-cols-5 gap-4">
        {observatoryModules.map(m => (
          <div class="p-5 rounded-2xl bg-[#0d1d16] border border-emerald-900/50 hover:border-lime-500/50 transition-colors flex flex-col justify-between">
            <div>
              <div class="flex items-center justify-between mb-3">
                <span class="text-2xl">{m.icon}</span>
                <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-emerald-950 text-lime-300 border border-emerald-800">
                  {m.badge}
                </span>
              </div>
              <h3 class="font-heading font-bold text-white text-sm mb-1">{m.title}</h3>
              <p class="text-[10px] text-lime-400 font-mono mb-2">{m.code}</p>
              <p class="text-xs text-stone-400 leading-relaxed">{m.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- In-Content Ad -->
  {siteConfig.revive?.zones?.inContent && (
    <div class="my-8 flex justify-center">
      <ReviveSlot format={siteConfig.revive.zones.inContent.format} zoneId={siteConfig.revive.zones.inContent.zoneId} />
    </div>
  )}

  <!-- Rapports et Analyses Récentes -->
  <section class="py-16 bg-[#060e0a]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center justify-between border-b border-emerald-950 pb-4 mb-10">
        <div>
          <span class="text-xs font-mono uppercase tracking-widest text-lime-400 font-bold block mb-1">Publications Scientifiques</span>
          <h2 class="text-2xl sm:text-3xl font-heading font-black text-white">Derniers Dossiers & Alertes</h2>
        </div>
        <a href="/blog/" class="text-xs sm:text-sm font-bold text-lime-400 hover:text-lime-300 flex items-center space-x-1">
          <span>Tous les dossiers ({allPosts.length})</span>
          <span>&rarr;</span>
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {featuredPosts.map(post => (
          <article class="p-6 rounded-2xl bg-[#091710] border border-emerald-950 hover:border-lime-500/40 transition-all flex flex-col justify-between group shadow-sm">
            <div>
              <div class="flex items-center justify-between mb-3 text-[11px]">
                <span class="font-mono text-lime-400 font-bold uppercase tracking-wider">
                  {post.data.category || 'Dossier Sargasses'}
                </span>
                <span class="text-stone-500 font-mono">
                  {new Date(post.data.pubDate).toLocaleDateString('fr-FR', { day: 'numeric', month: 'short', year: 'numeric' })}
                </span>
              </div>

              <h3 class="text-lg font-heading font-bold text-white group-hover:text-lime-300 transition-colors line-clamp-2 mb-3">
                <a href={`/blog/${post.id}/`}>{post.data.title}</a>
              </h3>

              <p class="text-xs text-stone-400 line-clamp-3 leading-relaxed mb-4">
                {post.data.description || 'Découvrez notre analyse détaillée des impacts, des prévisions météorologiques et des initiatives de terrain.'}
              </p>
            </div>

            <div class="pt-4 border-t border-emerald-950/80 flex items-center justify-between text-xs">
              <span class="text-stone-500 font-mono">Par {post.data.author || 'Observatoire Sargasse'}</span>
              <a href={`/blog/${post.id}/`} class="font-semibold text-lime-400 group-hover:translate-x-1 transition-transform inline-flex items-center space-x-1">
                <span>Consulter</span>
                <span>&rarr;</span>
              </a>
            </div>
          </article>
        ))}
      </div>

      <div class="mt-12 text-center">
        <a href="/blog/" class="inline-flex items-center space-x-2 px-8 py-3.5 rounded-xl bg-[#0f241a] border border-emerald-800 text-lime-300 font-heading font-bold text-sm hover:bg-lime-400 hover:text-emerald-950 transition-all">
          <span>Consulter les {allPosts.length} rapports de l'Observatoire</span>
          <span>&rarr;</span>
        </a>
      </div>
    </div>
  </section>
</Layout>
