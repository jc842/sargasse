---
import { siteConfig } from '../config/site.config';
import ReviveSlot from '../components/ads/ReviveSlot.astro';
import MobileStickyAd from '../components/ads/MobileStickyAd.astro';
import Matomo from '../components/analytics/Matomo.astro';

export interface Props {
  title?: string;
  description?: string;
  image?: string;
  article?: boolean;
  lang?: 'fr' | 'en' | 'es';
}

const {
  title = siteConfig.name,
  description = siteConfig.description,
  image = '/og-image.jpg',
  article = false,
  lang = 'fr',
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, siteConfig.url);

const colorThemes: Record<string, { body: string; header: string; accent: string; badge: string; footer: string }> = {
  'botanical-moss': {
    body: 'bg-[#0a1510] text-stone-100 selection:bg-lime-400 selection:text-emerald-950',
    header: 'bg-[#0d1d16]/90 border-emerald-900/50 backdrop-blur-md text-white',
    accent: 'text-lime-400 hover:text-lime-300',
    badge: 'bg-emerald-950/80 text-lime-300 border border-lime-500/30',
    footer: 'bg-[#060e0a] text-stone-400 border-emerald-950/80',
  }
};

const theme = colorThemes[siteConfig.theme?.colorScheme] || colorThemes['botanical-moss'];
---

<!DOCTYPE html>
<html lang={lang} class="scroll-smooth">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title === siteConfig.name ? title : `${title} | ${siteConfig.name}`}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalURL} />

  <!-- Hreflang Tags for i18n SEO (strict trailing slashes) -->
  <link rel="alternate" hreflang="fr" href={`${siteConfig.url}/`} />
  <link rel="alternate" hreflang="en" href={`${siteConfig.url}/en/`} />
  <link rel="alternate" hreflang="es" href={`${siteConfig.url}/es/`} />
  <link rel="alternate" hreflang="x-default" href={`${siteConfig.url}/`} />

  <!-- Google Fonts: Space Grotesk / Inter for eco-scientific aesthetic -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Space+Grotesk:wght@500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">

  <style>
    body {
      font-family: 'Inter', system-ui, -apple-system, sans-serif;
    }
    h1, h2, h3, .font-heading {
      font-family: 'Space Grotesk', system-ui, sans-serif;
      letter-spacing: -0.02em;
    }
    .font-mono {
      font-family: 'JetBrains Mono', monospace;
    }
  </style>

  <!-- Open Graph -->
  <meta property="og:type" content={article ? 'article' : 'website'} />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={new URL(image, siteConfig.url)} />

  <!-- Twitter -->
  <meta property="twitter:card" content="summary_large_image" />
  <meta property="twitter:url" content={canonicalURL} />
  <meta property="twitter:title" content={title} />
  <meta property="twitter:description" content={description} />

  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <!-- Matomo Tag Manager (Privacy-First / Cookieless) -->
  <Matomo />
</head>

<body class={`min-h-screen flex flex-col ${theme.body} pb-24 md:pb-0`}>
  <!-- Telemetry Satellite Bar -->
  <div class="bg-gradient-to-r from-emerald-950 via-[#0e241b] to-emerald-950 border-b border-emerald-800/40 text-[11px] py-1.5 px-4 text-emerald-300 font-mono">
    <div class="max-w-7xl mx-auto flex items-center justify-between">
      <div class="flex items-center space-x-2">
        <span class="inline-flex items-center px-1.5 py-0.5 rounded text-[10px] font-bold bg-lime-500/20 text-lime-300 border border-lime-500/30">
          SATELLITE RADAR
        </span>
        <span class="font-medium tracking-wide">
          ATLANTIQUE TROPICAL : DÉTECTION SENTINEL-3 MODÉRÉE | RISQUE D'ÉCHOUEMENT 72H : NIVEAU 2 (JAUNE)
        </span>
      </div>
      <div class="hidden md:flex items-center space-x-4 text-emerald-400/80">
        <span>STATIONS CAPTEURS H2S : EN SERVICE</span>
      </div>
    </div>
  </div>

  <!-- Header -->
  <header class={`sticky top-0 z-40 border-b shadow-lg shadow-black/40 ${theme.header}`}>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center justify-between h-16">
        <a href={lang === 'fr' ? '/' : `/${lang}/`} class="flex items-center space-x-3 group">
          <div class="w-9 h-9 rounded-lg bg-gradient-to-tr from-emerald-600 to-lime-400 flex items-center justify-center shadow-md shadow-lime-500/20">
            <svg class="w-5 h-5 text-emerald-950" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 2v20" />
              <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6" />
            </svg>
          </div>
          <div>
            <span class="text-xl font-heading font-black tracking-tight text-white group-hover:text-lime-400 transition-colors">
              SARGASSE<span class="text-lime-400">.COM</span>
            </span>
            <span class="block text-[10px] uppercase tracking-widest text-emerald-400 font-mono -mt-1">Observatoire Caraïbes</span>
          </div>
        </a>

        <!-- Navigation Desktop -->
        <nav class="hidden md:flex items-center space-x-6 text-sm font-semibold">
          <a href="/" class="hover:text-lime-400 transition-colors">{lang === 'es' ? 'Inicio' : (lang === 'en' ? 'Home' : 'Accueil')}</a>
          <a href="/blog/" class="hover:text-lime-400 transition-colors">{lang === 'es' ? 'Informes & Artículos' : (lang === 'en' ? 'Observatory Reports' : 'Rapports & Dossiers')}</a>
          <a href="/mentions-legales/" class="text-stone-400 hover:text-white transition-colors">{lang === 'es' ? 'Aviso legal' : (lang === 'en' ? 'Legal' : 'Mentions')}</a>
        </nav>

        <!-- Sélecteur de Langues -->
        <div class="flex items-center space-x-1.5 text-xs font-bold bg-[#11261d] border border-emerald-900/60 rounded-full px-2.5 py-1">
          <a href="/" class={`px-2 py-0.5 rounded-full transition-colors ${lang === 'fr' ? 'bg-lime-400 text-emerald-950 shadow-sm' : 'text-stone-300 hover:text-lime-300'}`}>FR</a>
          <span class="text-emerald-700">|</span>
          <a href="/en/" class={`px-2 py-0.5 rounded-full transition-colors ${lang === 'en' ? 'bg-lime-400 text-emerald-950 shadow-sm' : 'text-stone-300 hover:text-lime-300'}`}>EN</a>
          <span class="text-emerald-700">|</span>
          <a href="/es/" class={`px-2 py-0.5 rounded-full transition-colors ${lang === 'es' ? 'bg-lime-400 text-emerald-950 shadow-sm' : 'text-stone-300 hover:text-lime-300'}`}>ES</a>
        </div>
      </div>
    </div>
  </header>

  <!-- Leaderboard Ad Slot -->
  {siteConfig.revive?.zones?.header && (
    <div class="hidden md:flex justify-center my-4">
      <ReviveSlot format={siteConfig.revive.zones.header.format} zoneId={siteConfig.revive.zones.header.zoneId} />
    </div>
  )}

  <!-- Contenu Principal -->
  <main class="flex-grow">
    <slot />
  </main>

  <!-- Mobile Sticky Banner -->
  {siteConfig.revive?.zones?.mobileSticky && (
    <MobileStickyAd zoneId={siteConfig.revive.zones.mobileSticky.zoneId} />
  )}

  <!-- Footer -->
  <footer class={`mt-20 border-t ${theme.footer}`}>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
      <div class="grid grid-cols-1 md:grid-cols-4 gap-8 mb-8 text-sm">
        <div class="md:col-span-2">
          <div class="flex items-center space-x-2 mb-3">
            <span class="text-lg font-heading font-black tracking-tight text-white">
              SARGASSE<span class="text-lime-400">.COM</span>
            </span>
          </div>
          <p class="text-stone-400 text-xs leading-relaxed max-w-sm">
            Observatoire indépendant dédié au phénomène des algues sargasses dans le bassin caribéen : surveillance satellite, prévisions d'échouements, alertes sanitaires (H2S), technologies de ramassage et valorisation en économie circulaire.
          </p>
        </div>
        <div>
          <h4 class="text-xs uppercase tracking-wider text-lime-400 font-bold mb-3">Observatoire</h4>
          <ul class="space-y-2 text-xs">
            <li><a href="/" class="hover:text-lime-400">Accueil & Télédétection</a></li>
            <li><a href="/blog/" class="hover:text-lime-400">Tous les Rapports & Dossiers</a></li>
            <li><a href="/en/" class="hover:text-lime-400">English Scientific Guide</a></li>
            <li><a href="/es/" class="hover:text-lime-400">Guía del Sargazo en Español</a></li>
          </ul>
        </div>
        <div>
          <h4 class="text-xs uppercase tracking-wider text-lime-400 font-bold mb-3">Cadre Légal & RGPD</h4>
          <ul class="space-y-2 text-xs">
            <li><a href="/mentions-legales/" class="hover:text-lime-400">Mentions Légales</a></li>
            <li><a href="/politique-confidentialite/" class="hover:text-lime-400">Confidentialité RGPD (Cookieless)</a></li>
            <li><span class="text-stone-500">Données scientifiques ouvertes</span></li>
          </ul>
        </div>
      </div>
      <div class="border-t border-emerald-950/60 pt-6 flex flex-col sm:flex-row justify-between items-center gap-4 text-xs text-stone-500">
        <p>&copy; {new Date().getFullYear()} Sargasse.com — Tous droits réservés.</p>
        <p class="text-[11px] font-mono">Surveillance environnementale indépendante pour les Antilles.</p>
      </div>
    </div>
  </footer>

  <!-- Matomo Tracking -->
  
  <!-- Masquage propre des emplacements Revive sans bannière active -->
  <script is:inline>
    (function() {
      const reviveId = 'ac119b122a644588953c74c4c1daee06';
      document.addEventListener('revive-' + reviveId + '-loaded', function(e) {
        if (e && e.detail && e.detail.data && (!e.detail.data.width || Number(e.detail.data.width) === 0)) {
          const insEl = document.getElementById(e.detail.id);
          if (insEl) {
            const container = insEl.closest('.revive-slot-container') || insEl.parentElement;
            if (container) {
              container.style.display = 'none';
              const parentWrapper = container.parentElement;
              if (parentWrapper && (parentWrapper.classList.contains('flex-col') || parentWrapper.classList.contains('hidden') || parentWrapper.classList.contains('my-10') || parentWrapper.classList.contains('my-14') || parentWrapper.classList.contains('my-12')) && parentWrapper.children.length <= 2) {
                parentWrapper.style.display = 'none';
              }
            }
          }
        }
      });
    })();
  </script>
</body>
</html>
